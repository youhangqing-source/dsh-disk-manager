{
  "name": "dsh-disk-manager",
  "version": "0.4.0",
  "type": "module",
  "description": "Disk usage scanning, whitelist cleanup, and workspace tidy tools for DeepSeek Harness",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/youhangqing-source/dsh-disk-manager.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "disk",
    "cleanup",
    "workspace"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "scripts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-sidebar", "@deepseek-ai/dsh-client-ui-layout"]
    }
  }
}
